{
  "name": "guardvault",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GuardVault multi-signature wallet smart contract project.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "compile": "hardhat compile",
    "compile:foundry": "forge build",
    "clean": "hardhat clean && forge clean",
    "test": "forge test",
    "test:verbose": "forge test -vvv",
    "node": "anvil",
    "deploy": "node scripts/deploy.js",
    "fund": "node scripts/fund.js",
    "submit": "node scripts/submitTransaction.js",
    "approve": "node scripts/approveTransaction.js",
    "revoke": "node scripts/revokeApproval.js",
    "execute": "node scripts/executeTransaction.js",
    "status": "node scripts/status.js"
  },
  "dependencies": {
    "ethers": "^6.17.0",
    "lucide-react": "^1.37.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "hardhat": "^3.15.0",
    "vite": "^8.2.2"
  }
}
